# Copy this file to .env (no other name) and fill in PLEX_TOKEN.

# The server owner's Plex token (see README: "Finding your Plex token").
PLEX_TOKEN=

# Where Plex is, as seen from inside Docker. Leave blank when Plex runs on this same machine.
# Examples: http://192.168.1.20:32400
PLEX_URL=

# Port to open the web page on: http://<this-machine>:8765
JUKEBOX_PORT=8765

# The address people use to reach Jukebox. Only needed behind a reverse proxy,
# e.g. https://jukebox.example.com
PUBLIC_URL=

# Leave blank to let everyone you share the server with join in, or list
# usernames/emails separated by commas. The server owner is always included.
ALLOWED_USERS=

# Optional extras (defaults shown):
# PLAYLIST_PREFIX=👥 
# POLL_SECONDS=20
# PULL_FROM_PLEX=true

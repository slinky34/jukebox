# Copy this file to .env (no other name) and fill in PLEX_TOKEN.

# The server owner's Plex token (see README: "Finding your Plex token").
PLEX_TOKEN=

# Where Plex is, as seen from inside Docker. Leave blank when Plex runs on this same machine.
# Examples: http://192.168.1.20:32400
PLEX_URL=

# Port to open the web page on: http://<this-machine>:8765
JUKEBOX_PORT=8765

# The address people use to reach Jukebox. Only needed behind a reverse proxy,
# e.g. https://jukebox.example.com
PUBLIC_URL=

# Leave blank to let everyone you share the server with join in, or list
# usernames/emails separated by commas. The server owner is always included.
ALLOWED_USERS=

# ---- Importing from Spotify (optional) ----
# Without these, Spotify imports stop at the first 100 songs. Create a free app at
# https://developer.spotify.com/dashboard to get them. Apple Music and Deezer need nothing.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Downloading songs that aren't in Plex (optional) ----
# Set up deemix OR Lidarr (if both are set, deemix is used).
# Who may ask for downloads: owner (default), everyone, or off.
DOWNLOADS=owner

# deemix: its web address, and your Deezer "arl" cookie (see README).
DEEMIX_URL=
DEEMIX_ARL=

# Lidarr: its web address and API key (Lidarr > Settings > General).
# Root folder / profiles: leave blank for Lidarr's first one, or give a name.
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_ROOT_FOLDER=
LIDARR_QUALITY_PROFILE=
LIDARR_METADATA_PROFILE=

# Optional extras (defaults shown):
# WANTED_CHECK_MINUTES=10
# PLAYLIST_PREFIX=👥 
# POLL_SECONDS=10
# PULL_FROM_PLEX=true
